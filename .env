# Environment Variables for Hospital Management System - WebKoders
DEBUG=True
SECRET_KEY=django-insecure-webkoders-hospital-secret-key-123456789

# Database Configuration
# Default is 'sqlite'. To switch to PostgreSQL, change DB_ENGINE to 'postgresql'
DB_ENGINE=sqlite

# PostgreSQL Settings (Used when DB_ENGINE=postgresql)
DB_NAME=hospital_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Redis Cache Settings
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/1
